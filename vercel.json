{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/trueque-meta-site/browser",
  "rewrites": [
    {
      "source": "/rrhh",
      "destination": "/rrhh/index.html"
    },
    {
      "source": "/rrhh/",
      "destination": "/rrhh/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
